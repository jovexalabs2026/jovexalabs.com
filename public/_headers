/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://www.nasa.gov/feed/ https://api.worldbank.org/v2/country/ https://query.wikidata.org/sparql https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson https://eonet.gsfc.nasa.gov/api/v3/events; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Robots-Tag: noindex, nofollow

/code-preview*
  ! Content-Security-Policy
  Content-Security-Policy: sandbox allow-scripts allow-modals; default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; form-action 'none'; frame-src 'none'; base-uri 'none'; frame-ancestors 'self'
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  Cache-Control: no-store
  Referrer-Policy: no-referrer
